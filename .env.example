# Copy to .env and edit:  cp .env.example .env

# Your Ubuntu server's Tailscale IP -> `tailscale ip -4`
BIND_ADDR=100.x.y.z

# auto = newest on the chosen channel. Or pin a number.
# 36 = Android 16 (Baklava) — current STABLE, recommended.
ANDROID_API=36

# SDK channel: 0=stable, 1=beta, 2=dev, 3=canary.
# For the Android 17 (API 37) preview x86_64 image, set:
#   ANDROID_API=37
#   SDK_CHANNEL=3
SDK_CHANNEL=0

# google_apis | google_apis_playstore | google_atd (lean, no UI apps)
SYSTEM_IMAGE_TAG=google_apis

DEVICE_PROFILE=pixel_6

# i5-9600K = 6C/6T, 16 GB. Leave headroom for the host.
RAM_MB=4096
CORES=4
DATA_MB=8192

GPU_MODE=swiftshader_indirect
