# Copy to .env and edit:  cp .env.example .env

# Your Ubuntu server's Tailscale IP -> `tailscale ip -4`
BIND_ADDR=100.x.y.z

# --- Android version -------------------------------------------------------
# The value must match a package name EXACTLY as sdkmanager lists it: the part
# after "android-". Stable channel = bare integer (36). Preview channel =
# minor version (37.0, 37.1). See README "Checking what's available".
#
#   ANDROID_API=37.0   Android 17 (CinnamonBun) preview   [current default]
#   ANDROID_API=36     Android 16 (Baklava) stable
#   ANDROID_API=auto   newest on the selected channel
ANDROID_API=37.0

# SDK channel: 0=stable, 1=beta, 2=dev, 3=canary.
# Preview versions (37.x) require channel 3. For a stable build use:
#   ANDROID_API=36
#   SDK_CHANNEL=0
SDK_CHANNEL=3

# google_apis | google_apis_playstore | google_atd (lean, no UI apps)
SYSTEM_IMAGE_TAG=google_apis

DEVICE_PROFILE=pixel_6

# i5-9600K = 6C/6T, 16 GB. Leave headroom for the host.
RAM_MB=4096
CORES=4
DATA_MB=8192

GPU_MODE=swiftshader_indirect
