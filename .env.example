# Copy to .env and edit:  cp .env.example .env

# Your Ubuntu server's Tailscale IP -> `tailscale ip -4`
BIND_ADDR=100.x.y.z

# auto = newest STABLE Android (recommended). Or pin a number.
# 36 = Android 16 (Baklava, current stable). 37 = Android 17 is still PREVIEW
# and its google_apis x86_64 image isn't on the stable channel yet.
ANDROID_API=auto

# google_apis | google_apis_playstore | google_atd (lean, no UI apps)
SYSTEM_IMAGE_TAG=google_apis

DEVICE_PROFILE=pixel_6

# i5-9600K = 6C/6T, 16 GB. Leave headroom for the host.
RAM_MB=4096
CORES=4
DATA_MB=8192

GPU_MODE=swiftshader_indirect
